<?xml version="1.0" encoding="utf-8"?>
<!--
    List item layout for each installed application row.
    The background colour is set programmatically to handle
    selection highlight (navy blue / white).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="38dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Left: app name + package name (fill available width) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="@color/win_text"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/win_text_gray"
            android:singleLine="true"
            android:ellipsize="middle" />

    </LinearLayout>

    <!-- Right: cache size — colour-coded (set programmatically) -->
    <TextView
        android:id="@+id/tv_app_cache"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="@color/cache_medium"
        android:gravity="end|center_vertical" />

</LinearLayout>
