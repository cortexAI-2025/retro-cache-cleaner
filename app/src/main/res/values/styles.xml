<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         APPLICATION THEME — NoActionBar so we render our own NT4 title bar
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/win_gray</item>
        <item name="android:statusBarColor">@color/win_title_blue_start</item>
        <item name="android:navigationBarColor">@color/win_gray</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/win_title_blue_start</item>
        <item name="colorPrimaryDark">@color/win_title_blue_start</item>
        <item name="colorAccent">@color/win_title_blue_start</item>
        <!-- Remove ripple effects — they break the retro illusion -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         RETRO BUTTON — raised 3-D bevel, no ripple, no rounded corners
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="RetroButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/win_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:minWidth">75dp</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Compact variant for window control buttons [_][□][✕] -->
    <style name="RetroButton.WinControl">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">9sp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         RETRO DIALOG THEME — transparent window so our custom layout is
         the only chrome visible
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="RetroDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
