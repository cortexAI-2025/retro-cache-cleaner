<?xml version="1.0" encoding="utf-8"?>
<!-- State selector for the retro button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"  android:drawable="@drawable/bg_button_pressed" />
    <item android:state_focused="true"  android:drawable="@drawable/bg_button_normal" />
    <item android:state_enabled="false">
        <!-- Disabled: flat gray, no bevel depth -->
        <shape android:shape="rectangle">
            <solid android:color="#C0C0C0" />
            <stroke android:width="1dp" android:color="#808080" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_button_normal" />
</selector>
