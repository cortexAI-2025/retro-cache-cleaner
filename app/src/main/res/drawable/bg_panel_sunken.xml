<?xml version="1.0" encoding="utf-8"?>
<!--
    Sunken / inset panel — inverted bevel.
    Used for: list view frame, text input areas.
    Interior: white (#FFFFFF).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer dark gray (top-left shadow) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#808080" />
        </shape>
    </item>

    <!-- Inner black shadow (top-left, inset from right+bottom) -->
    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Outer white highlight (bottom-right) -->
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- White interior -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

</layer-list>
