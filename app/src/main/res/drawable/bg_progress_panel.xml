<?xml version="1.0" encoding="utf-8"?>
<!--
    Sunken panel for the progress bar track.
    Same bevel as bg_panel_sunken but with a black interior so the
    blue segments contrast sharply (authentic Windows look).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#808080" />
        </shape>
    </item>

    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Black track interior -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

</layer-list>
