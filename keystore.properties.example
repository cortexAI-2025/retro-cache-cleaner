# ─────────────────────────────────────────────────────────────────────────────
#  Retro Cache Cleaner — Keystore configuration template
# ─────────────────────────────────────────────────────────────────────────────
#
#  INSTRUCTIONS
#  ────────────────────────────────────────────────────────────────────────────
#  1. Copy this file :  cp keystore.properties.example keystore.properties
#  2. Fill in your keystore values below.
#  3. NEVER commit keystore.properties or your .jks file to version control!
#     Both are listed in .gitignore.
#
#  GENERATING A KEYSTORE (first time)
#  ────────────────────────────────────────────────────────────────────────────
#  keytool -genkey -v \
#    -keystore my-release-key.jks \
#    -keyalg RSA -keysize 2048 -validity 10000 \
#    -alias retro-cache-cleaner \
#    -dname "CN=Votre Société, OU=Android, O=Votre Société, L=Paris, ST=IDF, C=FR"
#
#  BUILDING THE AAB
#  ────────────────────────────────────────────────────────────────────────────
#  ./gradlew bundleRelease
#  → output: app/build/outputs/bundle/release/app-release.aab
#
# ─────────────────────────────────────────────────────────────────────────────

# Path to the keystore file (relative to project root, or absolute path)
storeFile=../my-release-key.jks

# Keystore password (set when running keytool -genkey)
storePassword=CHANGEME_keystore_password

# Key alias (the -alias value used with keytool)
keyAlias=retro-cache-cleaner

# Key password (can be the same as storePassword)
keyPassword=CHANGEME_key_password
